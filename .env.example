# Reference values only. The server does not load .env automatically.
# Export these values in your shell or configure them in the process manager.

TABLETOP_ENV=local
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
TABLETOP_DATA_DIR=./server/.data

# Leave empty for local PGlite mode. Local mode refuses a non-empty DATABASE_URL.
DATABASE_URL=

# Optional locally; same-origin checks can derive the origin from the request.
# Production requires the exact public HTTPS origin.
PUBLIC_ORIGIN=

# Server-only provider credential. Keep this tracked example empty.
# Configure the value in hosting Secrets or an ignored local file.
# Never use a VITE_ prefix or give the browser this credential.
# The provider probe can use DEEPSEEK_KEY; app routes remain disabled until
# authenticated dispatch and durable cost accounting are connected.
DEEPSEEK_KEY=
