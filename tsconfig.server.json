{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["node"], "verbatimModuleSyntax": true
  },
  "include": ["server/**/*.ts", "src/tabletop/shared/**/*.ts", "src/tabletop/domain/**/*.ts"]
}
