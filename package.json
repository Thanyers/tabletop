{
  "name": "tabletop",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "agents:setup": "node scripts/setup-agent-startup.mjs",
    "test:agents": "node --test scripts/agent-startup.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --import tsx server/bootstrap.ts",
    "build": "node scripts/generate-public-demo.mjs --check && npm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json && tsc -p tsconfig.cloudflare.json",
    "lint": "eslint .",
    "dev:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787 --var PUBLIC_ORIGIN:http://127.0.0.1:8787",
    "test:cloudflare": "vitest run --config vitest.cloudflare.config.ts",
    "test:cloudflare:browser": "node tests/cloudflare-browser.mjs",
    "test:generative:browser": "node --import tsx tests/generative-canvas-browser.mjs",
    "test:generative:live": "node --import tsx scripts/generic-table-local.mjs --real-ai --generative-auto",
    "demo:auto": "npm run build && npm run build:cloudflare && node scripts/auto-demo.mjs",
    "demo:auto:run": "node scripts/auto-demo.mjs",
    "demo:auto:view": "node scripts/serve-auto-demo.mjs",
    "build:cloudflare": "wrangler deploy --dry-run --outdir worker-build",
    "start": "node --import tsx server/bootstrap.ts",
    "test:r1": "vitest run src/tabletop server",
    "test:r1:browser": "node --import tsx tests/tabletop-r1.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:spatial": "node tests/spatial-learning.mjs",
    "test:constellation": "node tests/constellation-demo.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/noto-sans-thai": "^5.2.7",
    "@xyflow/react": "^12.9.0",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "miniflare": "5.20261012.1-beta",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.12",
    "recharts": "^3.0.0",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.72.0",
    "vite": "^6.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.151.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint"
  }
}
