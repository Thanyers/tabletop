{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node"], "verbatimModuleSyntax": true
  },
  "include": ["cloudflare/**/*.ts"],
  "exclude": ["cloudflare/**/*.test.ts", "cloudflare/test-setup.ts"]
}
